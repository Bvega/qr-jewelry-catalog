{
  "name": "between-us-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "npm run validate:baseline",
    "validate:baseline": "node scripts/validate-baseline.mjs",
    "validate:intake": "node scripts/validate-content-intake.mjs && node scripts/summarize-content-intake.mjs",
    "validate:supabase": "node scripts/validate-supabase-foundation.mjs && node --test tests/supabase-foundation/*.test.mjs",
    "admin:config": "node scripts/generate-admin-config.mjs",
    "admin:build": "node scripts/build-admin.mjs",
    "admin:serve": "node scripts/serve-static.mjs",
    "admin:validate": "node scripts/validate-seller-manager.mjs",
    "migration:prepare": "node scripts/prepare-catalog-migration.mjs",
    "migration:validate": "node scripts/validate-catalog-migration.mjs",
    "migration:test": "node --test tests/catalog-migration/*.test.mjs",
    "pages:build": "node scripts/build-pages-artifact.mjs",
    "pages:validate": "node scripts/validate-pages-artifact.mjs",
    "pages:test": "node --test tests/deployment/*.test.mjs",
    "pages:check": "node scripts/check-pages.mjs",
    "pages:check:ci": "node scripts/check-pages-ci.mjs",
    "pages:serve": "node scripts/serve-pages-artifact.mjs",
    "m08:check": "node scripts/check-m08.mjs",
    "m08:check:ci": "node scripts/check-m08-ci.mjs",
    "m09:check": "node scripts/check-m09.mjs",
    "m09:stage-b:check": "node --test tests/browser-validation/stage-b.test.mjs tests/browser-validation/local-canary-photo.test.mjs",
    "m09:stage-b:evidence": "node scripts/browser-validation/validate-stage-b-evidence.mjs",
    "m09:stage-b:prepare": "node scripts/browser-validation/local-canary.mjs prepare",
    "m09:stage-b:rotate-credentials": "node scripts/browser-validation/local-canary.mjs rotate-credentials",
    "m09:stage-b:show-credentials": "node scripts/browser-validation/local-canary.mjs show-credentials",
    "m09:stage-b:verify-hidden": "node scripts/browser-validation/local-canary.mjs verify-hidden",
    "m09:stage-b:verify-published": "node scripts/browser-validation/local-canary.mjs verify-published",
    "m09:stage-b:verify-unpublished": "node scripts/browser-validation/local-canary.mjs verify-unpublished",
    "m09:stage-b:cleanup": "node scripts/browser-validation/local-canary.mjs cleanup",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:lint": "supabase db lint --local"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.7"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "supabase": "2.109.1"
  }
}
