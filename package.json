{
  "name": "between-us-platform",
  "private": true,
  "scripts": {
    "validate": "npm run validate:baseline",
    "validate:baseline": "node scripts/validate-baseline.mjs",
    "validate:intake": "node scripts/validate-content-intake.mjs && node scripts/summarize-content-intake.mjs",
    "validate:supabase": "node scripts/validate-supabase-foundation.mjs && node --test tests/supabase-foundation/*.test.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:lint": "supabase db lint --local"
  },
  "devDependencies": {
    "supabase": "2.109.1"
  }
}
